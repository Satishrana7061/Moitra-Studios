{
    "name": "rajneeti-backend",
    "version": "1.0.0",
    "private": true,
    "type": "module",
    "scripts": {
        "dev": "tsx watch src/server.ts",
        "start": "tsx src/server.ts",
        "build": "tsc",
        "seed-assets": "tsx src/seed_media_assets.ts",
        "seed-promise-images": "tsx src/seed_promise_images.ts",
        "cast:plan": "tsx src/buildCaricatureCast.ts --dry-run",
        "cast:build": "tsx src/buildCaricatureCast.ts",
        "money:validate": "tsx src/validateMoneyCurriculum.ts",
        "money:check": "tsx src/checks/checkcur.ts && tsx src/checks/checkgen.ts && tsx src/checks/checkalign.ts && tsx src/checks/checkbuilder.ts && tsx src/checks/checkcreds.ts && tsx src/checks/checkaudio.ts",
        "money:voices": "tsx src/listMoneyVoices.ts",
        "money:episode": "tsx src/generateMoneyEpisode.ts",
        "money:e2e": "tsx src/checks/checkpipeline.ts",
        "money:probe-facts": "tsx src/probeFactSources.ts",
        "money:research": "tsx src/researchMoneyFacts.ts"
    },
    "dependencies": {
        "@ffmpeg-installer/ffmpeg": "^1.1.0",
        "@supabase/supabase-js": "^2.104.1",
        "@types/multer": "^2.1.0",
        "cors": "^2.8.5",
        "dotenv": "^16.4.7",
        "express": "^4.21.2",
        "fluent-ffmpeg": "^2.1.3",
        "googleapis": "^171.4.0",
        "multer": "^2.1.1",
        "puppeteer": "^24.42.0",
        "replicate": "^1.4.0",
        "rss-parser": "^3.13.0"
    },
    "devDependencies": {
        "@types/cors": "^2.8.17",
        "@types/express": "^5.0.0",
        "@types/node": "^22.14.0",
        "tsx": "^4.19.3",
        "typescript": "~5.8.2"
    }
}
