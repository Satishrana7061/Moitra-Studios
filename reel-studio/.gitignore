node_modules
out
.remotion

# Generated by scripts/build-asset-manifest.mjs from `Game FinalGraphics/`.
# The source art is committed; these are re-encoded copies (~4.7 MB) and are
# rebuilt in CI, so keeping them out of git avoids duplicating the art kit.
public/game/

# Fonts are copied here from rajneeti-backend/assets/fonts by the same script,
# so they LOOK like build output — but Remotion bundles whatever sits in
# public/, and a missing font is a hard render failure, not a degraded one.
#
# Ignoring the whole directory is what broke the first CI episode run: a fresh
# checkout had no Outfit.ttf, the FontFace fetch 404'd, and the render died with
# a DOMException. It passed locally only because this machine still had the file
# from an earlier build:assets run.
#
# So the display face is COMMITTED (110 KB) and reel-studio stays self-contained
# — regenerating it would otherwise mean pulling the 62 MB `Game FinalGraphics/`
# tree and sharp into every workflow that renders.
#
# The 647 KB Devanagari face stays ignored: nothing has rendered Devanagari
# since the on-screen text moved to English.
public/fonts/NotoSansDevanagari.ttf

# Generated by the caricature cast build. Images live in Supabase Storage;
# only the manifest is committed.
public/cast/
